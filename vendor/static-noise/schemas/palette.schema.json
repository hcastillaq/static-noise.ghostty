{
  "$id": "https://github.com/hcastillaq/static-noise/blob/main/schemas/palette.schema.json",
  "title": "Static Noise Design Token Contract",
  "type": "object",
  "required": ["$schema", "$description", "name", "version", "primitives", "semantic", "domains", "projections"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "$description": { "type": "string", "minLength": 1 },
    "name": { "const": "Static Noise" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "primitives": { "$ref": "#/$defs/group" },
    "semantic": { "$ref": "#/$defs/group" },
    "domains": { "$ref": "#/$defs/group" },
    "projections": { "$ref": "#/$defs/group" }
  },
  "$defs": {
    "group": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/node" }
    },
    "node": {
      "oneOf": [
        { "$ref": "#/$defs/group" },
        { "$ref": "#/$defs/token" }
      ]
    },
    "token": {
      "type": "object",
      "required": ["$type", "$value", "$description"],
      "additionalProperties": false,
      "properties": {
        "$type": { "const": "color" },
        "$value": {
          "type": "string",
          "pattern": "^(#[0-9A-Fa-f]{6}|\\{[A-Za-z0-9_.-]+\\})$"
        },
        "$description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
